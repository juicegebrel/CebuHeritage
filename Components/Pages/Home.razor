@page "/"
@inject PlaceService Places

<PageTitle>Cebu Heritage | History, culture and places to visit</PageTitle>

<section class="bg-ink text-white">
    <Bunting />
    <div class="mx-auto max-w-6xl px-4 pb-20 pt-14 sm:px-6 sm:pb-28 sm:pt-20">
        <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.05] sm:text-7xl">
            Cebu, one town at a time.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
            Read how each city and municipality got its story, what its people celebrate, and where to go and stay when you visit.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href="/places" class="btn-primary">Explore all places</a>
            <a href="/places/cebu-city" class="btn-light">Start with Cebu City</a>
        </div>

        <dl class="mt-14 grid max-w-xl grid-cols-3 gap-6 border-t border-white/15 pt-6">
            <div>
                <dt class="text-sm text-white/60">Places</dt>
                <dd class="font-display text-3xl font-bold">@all.Count</dd>
            </div>
            <div>
                <dt class="text-sm text-white/60">To visit</dt>
                <dd class="font-display text-3xl font-bold">@all.Sum(p => p.Attractions.Count)</dd>
            </div>
            <div>
                <dt class="text-sm text-white/60">To stay</dt>
                <dd class="font-display text-3xl font-bold">@all.Sum(p => p.Stays.Count)</dd>
            </div>
        </dl>
    </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
        <h2 class="section-title">Where to begin</h2>
        <a href="/places" class="hidden text-sm font-semibold text-sea-dark hover:text-sinulog sm:block">See every place</a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var place in all.Take(6))
        {
            <PlaceCard Place="place" />
        }
    </div>
</section>

<section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h2 class="section-title">Dates that shaped Cebu</h2>
        <p class="mt-3 max-w-2xl text-ink/70">Four moments you will see referred to again and again as you move around the province.</p>

        <ol class="mt-10 grid gap-8 md:grid-cols-4">
            @foreach (var (year, title, text) in timeline)
            {
                <li class="border-t-4 border-sinulog pt-4">
                    <p class="font-display text-3xl font-extrabold text-sinulog">@year</p>
                    <h3 class="mt-2 text-lg font-bold">@title</h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink/75">@text</p>
                </li>
            }
        </ol>
    </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="section-title">Browse by area</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var region in Places.Regions)
        {
            var inRegion = all.Where(p => p.Region == region).ToList();
            <a href="/places?region=@Uri.EscapeDataString(region)"
               class="rounded-2xl bg-sea-light p-6 transition-colors hover:bg-saffron/50">
                <h3 class="text-lg font-bold text-sea-dark">@region</h3>
                <p class="mt-1 text-sm text-ink/70">@string.Join(", ", inRegion.Select(p => p.Name))</p>
            </a>
        }
    </div>
</section>

@code {
    private IReadOnlyList<Place> all = Array.Empty<Place>();

    private static readonly (string Year, string Title, string Text)[] timeline =
    {
        ("1521", "Magellan reaches Cebu", "A cross is planted in Cebu and the Battle of Mactan follows, with Lapulapu defeating Magellan."),
        ("1565", "First Spanish settlement", "Legazpi founds a town in Cebu, which becomes the base of Spanish rule in the islands."),
        ("1937", "Cebu becomes a chartered city", "Cebu City receives its charter and grows into the Visayas' centre of commerce."),
        ("1961", "Lapu-Lapu City is chartered", "The town of Opon on Mactan takes the name of its hero."),
    };

    protected override void OnInitialized() => all = Places.GetAll();
}
