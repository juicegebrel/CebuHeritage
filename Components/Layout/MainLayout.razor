@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col">
    <NavMenu />

    <main class="flex-1">
        @Body
    </main>

    <footer class="bg-ink text-white/80">
        <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="font-display text-xl font-bold text-white">Cebu Heritage</p>
                    <p class="mt-2 max-w-sm text-sm">A guide to the history, culture and places to visit and stay across Cebu's cities and towns.</p>
                </div>
                <nav class="flex gap-6 text-sm" aria-label="Footer">
                    <a href="/" class="hover:text-saffron">Home</a>
                    <a href="/places" class="hover:text-saffron">Explore places</a>
                </nav>
            </div>
            <p class="mt-8 border-t border-white/15 pt-6 text-xs text-white/60">
                Travel times, festival dates and accommodation can change. Check current details with local sources before you travel.
            </p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
